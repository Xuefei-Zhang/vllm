# Source this file BEFORE running vllm to enable runtime tracing.
#   source scripts/runtime-trace.env       # daily learning mode
#   source scripts/runtime-trace.env deep  # deep trace (SLOW, 100x slowdown)
#
# All flags are sourced from vllm/envs.py. Citations in comments.

# ===== Daily learning mode (always on) =====
export VLLM_LOGGING_LEVEL=DEBUG                 # vllm/envs.py: master log verbosity; many modules gate debug behavior on this
export VLLM_LOGGING_COLOR=1                     # force colored output
export VLLM_LOG_STATS_INTERVAL=1                # engine stats every 1s instead of 10s
export VLLM_LOG_BATCHSIZE_INTERVAL=1            # log batch size every 1s
export VLLM_LOG_MODEL_INSPECTION=1              # dump hierarchical model structure on load
export VLLM_DEBUG_WORKSPACE=1                   # log worker workspace allocation/resizing
export VLLM_DEBUG_LOG_API_SERVER_RESPONSE=true  # log API server responses (only if running serve)

# torch.compile / Inductor inspection
export VLLM_DEBUG_DUMP_PATH=/tmp/vllm_debug_dumps
export VLLM_COMPILE_CACHE_SAVE_FORMAT=unpacked  # editable Inductor output (single-process only)
mkdir -p "$VLLM_DEBUG_DUMP_PATH"

# Profiler scopes (cheap; great for Nsight Systems)
export VLLM_NVTX_SCOPES_FOR_PROFILING=1
export VLLM_CUSTOM_SCOPES_FOR_PROFILING=1

# torch.compile traces (consumed by `tlparse` to view IR transformations)
export TORCH_TRACE=/tmp/torch_trace
export TORCH_LOGS=+dynamic                      # show Dynamo guard events
mkdir -p "$TORCH_TRACE"

# ===== Deep trace mode (opt-in, severe slowdown) =====
if [[ "${1:-}" == "deep" ]]; then
  echo "[runtime-trace] DEEP MODE: ~100x slowdown. Use only for short reproductions."
  export VLLM_TRACE_FUNCTION=1                  # record every function call to .trace file
  export VLLM_DISABLE_COMPILE_CACHE=1           # force fresh compile each run
  export CUDA_LAUNCH_BLOCKING=1                 # synchronous CUDA launches (locate failing kernel)
  export NCCL_DEBUG=TRACE                       # max NCCL verbosity (multi-GPU only)
fi

echo "[runtime-trace] mode=${1:-daily}  VLLM_LOGGING_LEVEL=$VLLM_LOGGING_LEVEL"
echo "[runtime-trace] dumps -> $VLLM_DEBUG_DUMP_PATH ; torch traces -> $TORCH_TRACE"
